  "item": [
    {
      "name": "1. Get Sandbox Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Token request succeeded', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test('Response contains a bearer token', () => {",
              "    pm.expect(data.access_token).to.be.a('string').and.not.empty;",
              "    pm.expect(data.token_type.toLowerCase()).to.eql('bearer');",
              "  });",
              "  if (typeof data.access_token === 'string' && data.access_token) {",
              "    pm.collectionVariables.set('access_token', data.access_token);",
              "  }",
              "} else {",
              "  pm.collectionVariables.unset('access_token');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "client_id",
              "value": "{{client_id}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{client_secret}}",
              "type": "text"
            },
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            },
            {
              "key": "scope",
              "value": "{{scopes}}",
              "type": "text"
            }
          ]
        },
        "url": "https://sandbox-login.uber.com/oauth/v2/token",
        "description": "Enter client_id and client_secret in the collection variables using local values. A successful response automatically saves access_token for Get Order. Postman generates the multipart Content-Type boundary."
      },
      "response": []
    },
